# Copy to .env.production and fill in values before deploying.
# Never commit .env.production to git.

# Required in production (random hex string, min 32 chars)
SECRET_KEY=replace-with-a-long-random-string

# Optional: switch from in-process SimpleCache to Redis for shared cache
# across multiple gunicorn workers or servers
# CACHE_TYPE=RedisCache
# REDIS_URL=redis://localhost:6379/0

# Optional: share rate-limit counters across workers via Redis
# RATELIMIT_STORAGE_URI=redis://localhost:6379/1
