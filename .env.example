# Copy this file to .env and fill in values for your environment.
# SECRET_KEY is required unless FLASK_DEBUG=1 is set (local development).

# Flask session signing key. Set a stable value in production so sessions survive restarts.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-stable-secret-key-here

# Port for the development server (default: 5000).
PORT=5000

# Set to "true" to run run.py with the Flask debugger and reloader (default: false).
DEBUG=false

# Set to 1 to enable the card-page "remove link" button, which rewrites edges.json.
# Leave unset in production.
# ALLOW_EDGE_EDIT=1
